RewriteEngine On

# eliminar .php
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]


# ACCESORIOS
RewriteRule ^accesorios$ vistas/vistas-user/accesorios/accesorios.php [L,QSA]

# ACCESORIOS PS5
RewriteRule ^accesorios/ps5$ vistas/vistas-user/accesorios/accesorios-ps5.php [L,QSA]

# ACCESORIOS XBOX
RewriteRule ^accesorios/xbox$ vistas/vistas-user/accesorios/accesorios-xbox.php [L,QSA]

# ACCESORIOS SWITCH
RewriteRule ^accesorios/switch$ vistas/vistas-user/accesorios/accesorios-nintendo-switch.php [L,QSA]



# VIDEOJUEGOS
RewriteRule ^videojuegos$ vistas/vistas-user/videojuegos/videojuegos.php [L,QSA]

# VIDEOJUEGOS PS5
RewriteRule ^videojuegos/ps5$ vistas/vistas-user/videojuegos/videojuegos-ps5.php [L,QSA]

# VIDEOJUEGOS XBOX
RewriteRule ^videojuegos/xbox$ vistas/vistas-user/videojuegos/videojuegos-xbox.php [L,QSA]

# VIDEOJUEGOS SWITCH
RewriteRule ^videojuegos/switch$ vistas/vistas-user/videojuegos/videojuegos-nintendo-switch.php [L,QSA]



# CONSOLAS
RewriteRule ^consolas$ vistas/vistas-user/consolas/consolas.php [L,QSA]

# CONSOLAS PS5
RewriteRule ^consolas/ps5$ vistas/vistas-user/consolas/consolas-ps5.php [L,QSA]

# CONSOLAS XBOX
RewriteRule ^consolas/xbox$ vistas/vistas-user/consolas/consolas-xbox.php [L,QSA]

# CONSOLAS SWITCH
RewriteRule ^consolas/switch$ vistas/vistas-user/consolas/consolas-nintendo-switch.php [L,QSA]


# PERFIL CUENTA
RewriteRule ^perfil$ vistas/vistas-user/cuenta/perfil.php [L,QSA]

# HISTORIAL DE PEDIDOS
RewriteRule ^historial$ vistas/vistas-user/cuenta/historial.php [L,QSA]





# AUTENTIFICACION
RewriteRule ^autentificacion$ acciones/login/autentificacion.php [L,QSA]

# PROCESAR REGISTRO
RewriteRule ^procesar-registro$ acciones/login/procesar-registro.php [L,QSA]

# LOGOUT
RewriteRule ^logout$ acciones/login/logout.php [L,QSA]

# LOGIN
RewriteRule ^login$ vistas/vistas-login/login.php [L,QSA]

# REGISTRO
RewriteRule ^registro$ vistas/vistas-login/registro.php [L,QSA]










# PRODUCTO
RewriteRule ^producto/([a-zA-Z0-9-]+)$ producto.php?slug=$1 [L,QSA]

# CATEGORIA
RewriteRule ^categoria/([a-zA-Z0-9_-]+)$ categoria.php?nombre=$1 [L,QSA]

# AGREGAR AL CARRITO
RewriteRule ^agregar-carrito$ acciones/carrito/agregar-carrito.php [L,QSA]

# ELIMINAR DEL CARRITO
RewriteRule ^eliminar-carrito$ acciones/carrito/eliminar-producto-del-carrito.php [L,QSA]


# CHECKOUT
RewriteRule ^aplicar-cupon$ acciones/cupones/aplicar-cupon.php [L,QSA]

# CHECKOUT
RewriteRule ^pasarela$ vistas/vistas-user/proceso-pago/pasarela.php [L,QSA]

# CHECKOUT
RewriteRule ^checkout$ vistas/vistas-user/proceso-pago/envio-pago.php [L,QSA]

# PEDIDOS
RewriteRule ^pedido/([0-9]+)$ pedido.php?id=$1 [L,QSA]

# ADMIN
RewriteRule ^admin/pedidos$ actualizar-pedidos.php [L,QSA]

# HOME (IMPORTANTE)
RewriteRule ^$ index.php [L,QSA]



# si existe archivo .php, úsalo automáticamente
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^([^/]+)/?$ $1.php [L]